# Copy to .env. Paths must be absolute. Empty values use the defaults in config.sh.
# Set this only after accepting NVIDIA's Isaac Sim additional software terms.
OMNI_KIT_ACCEPT_EULA=YES

# auto selects an A100 inside CUDA_VISIBLE_DEVICES when that mask is set.
# Set a physical nvidia-smi index or UUID only when selecting a specific device.
ISAAC_GPU=auto
A100SIM_EXPECTED_GPU_UUID=

# Runtime downloads and artifacts default to this a100/ directory.
A100SIM_ROOT=
# Use a portable uv-managed CPython 3.12 executable; detected via uv when empty.
A100SIM_PYTHON=
# Empty: detect CUDA_HOME, CUDA_PATH, nvcc, then /usr/local/cuda.
A100SIM_CUDA_ROOT=
# Empty: detect the installed driver; extracted libraries must match it.
A100SIM_DRIVER_VERSION=
A100SIM_NVIDIA_ROOT=
# Optional mirror URLs; the default tries NVIDIA's Tesla then XFree86 archives.
# When configured, only the specified mirror is used.
A100SIM_NVIDIA_RUN_URL=
A100SIM_NVIDIA_DEB_URL=
# Optional directory containing newer libstdc++.so.6 and libgcc_s.so.1.
# Usually unnecessary after install-libs.sh installs the Noble C++ runtime.
A100SIM_CXX_LIB_DIR=

# All mesh and Gaussian asset directories must be inside this directory.
# Default: <A100SIM_ROOT>/assets. Symlink escapes are rejected.
A100SIM_ASSET_ROOT=
# Optional preloaded renderer asset; needs mesh.npz and/or object.ply.
A100SIM_RENDER_ASSET=

# Private per-user job files on a local disk, avoiding shared filesystem metadata.
A100SIM_LOCAL_STATE=
A100SIM_STATE_ROOT=
A100SIM_RESIDENT_PORT=8321
A100SIM_GENERIC_PORT=18323
A100SIM_RENDER_PORT=8320
A100SIM_QUEUE_SIZE=64

# Optional robotics/physics-sensor service; install-features.sh all first.
A100SIM_FEATURE_PORT=8322
A100SIM_FEATURE_ARMS=4
A100SIM_FEATURE_ROS2=1
A100SIM_FEATURES_ROOT=
# Default ROS discovery stays on this host; use a separate domain for each deployment.
ROS_DOMAIN_ID=80
ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST

# Newton compatibility: auto detects the loaded CUDA driver's capabilities.
# on requires CUDA driver API >= 12.4 for conditional graph nodes.
A100SIM_NEWTON_CONDITIONAL_GRAPHS=auto
# auto loads a matching locally compiled override when available; off uses the wheel.
# on requires build-newton-kernels.sh and validates its plugin/library hashes.
A100SIM_NEWTON_NATIVE_KERNELS=auto
