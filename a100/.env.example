# Copy to .env. Paths must be absolute. Empty values use the defaults in config.sh.
# Set this only after accepting NVIDIA's Isaac Sim additional software terms.
OMNI_KIT_ACCEPT_EULA=YES

# A physical nvidia-smi index or UUID. The launcher resolves it to a UUID.
ISAAC_GPU=0
A100SIM_EXPECTED_GPU_UUID=

# Runtime downloads and artifacts default to this a100/ directory.
A100SIM_ROOT=
# Use a portable uv-managed CPython 3.12 executable; detected via uv when empty.
A100SIM_PYTHON=
# Empty: prefer cuda-12.2, otherwise /usr/local/cuda; detect the selected GPU's driver.
A100SIM_CUDA_ROOT=
A100SIM_DRIVER_VERSION=
A100SIM_NVIDIA_ROOT=
# Optional directory containing newer libstdc++.so.6 and libgcc_s.so.1.
# Usually unnecessary after install-libs.sh installs the Noble C++ runtime.
A100SIM_CXX_LIB_DIR=

# All mesh and Gaussian asset directories must be inside this directory.
# Default: <A100SIM_ROOT>/assets. Symlink escapes are rejected.
A100SIM_ASSET_ROOT=
# Optional preloaded renderer asset; needs mesh.npz and/or object.ply.
A100SIM_RENDER_ASSET=

# Private per-user job files on a local disk, avoiding shared filesystem metadata.
A100SIM_LOCAL_STATE=
A100SIM_STATE_ROOT=
A100SIM_RESIDENT_PORT=8321
A100SIM_GENERIC_PORT=18323
A100SIM_RENDER_PORT=8320
A100SIM_QUEUE_SIZE=64
