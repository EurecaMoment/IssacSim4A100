diff --git a/src/cuda_eval.cpp b/src/cuda_eval.cpp
index 7e1e5e0..590c6e8 100644
--- a/src/cuda_eval.cpp
+++ b/src/cuda_eval.cpp
@@ -796,18 +796,19 @@ static void jitc_cuda_render(Variable *v) {
             break;
         }
 
-        case VarKind::Copysign:
-            // PTX only provides 'copysign' for single/double precision. Note
-            // that its operands are reversed with respect to the C convention.
-            if (jitc_is_half(v))
-                fmt("    .reg.$b $v_m, $v_s;\n"
-                    "    and.$b $v_m, $v, 0x7fff;\n"
-                    "    and.$b $v_s, $v, 0x8000;\n"
-                    "    or.$b $v, $v_m, $v_s;\n",
-                    v, v, v, v, v, a0, v, v, a1, v, v, v, v);
-            else
-                fmt("    copysign.$t $v, $v, $v;\n", v, v, a1, a0);
+        case VarKind::Copysign: {
+            // CUDA-only bitwise form also works on A100 with the R535 OptiX JIT.
+            // Preserve the magnitude and copy only the sign bit (IEEE-754).
+            const char *mask = jitc_is_half(v) ? "0x8000" :
+                               jitc_is_single(v) ? "0x80000000" :
+                               "0x8000000000000000";
+            fmt("    .reg.$b $v_s;\n"
+                "    xor.$b $v_s, $v, $v;\n"
+                "    and.$b $v_s, $v_s, $s;\n"
+                "    xor.$b $v, $v, $v_s;\n",
+                v, v, v, v, a0, a1, v, v, v, mask, v, v, a0, v);
             break;
+        }
 
         case VarKind::Ceil:
             fmt("    cvt.rpi.$t.$t $v, $v;\n", v, a0, v, a0);
diff --git a/src/lock.h b/src/lock.h
index d601baf..740f184 100644
--- a/src/lock.h
+++ b/src/lock.h
@@ -47,7 +47,15 @@
 // https://github.com/microsoft/mimalloc/blob/master/include/mimalloc/prim.h
 #if defined(__linux__)
 
-inline uintptr_t thread_id() { return (uintptr_t) __builtin_thread_pointer(); }
+inline uintptr_t thread_id() {
+#if defined(__x86_64__)
+    uintptr_t result;
+    __asm__("movq %%fs:0, %0" : "=r" (result));
+    return result;
+#else
+    return (uintptr_t) __builtin_thread_pointer();
+#endif
+}
 
 #elif defined(__APPLE__)
