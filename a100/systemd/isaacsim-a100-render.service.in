[Unit]
Description=Isaac Sim A100 render
StartLimitIntervalSec=180
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@WORKING_DIRECTORY@
ExecStart=/bin/bash "@CODE_ROOT@/serve.sh" render
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
LimitNOFILE=65536
UMask=0077
StandardOutput=journal
StandardError=inherit

[Install]
WantedBy=default.target
