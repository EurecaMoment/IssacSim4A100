[Unit]
Description=Isaac Sim A100 robotics, sensors and ROS 2
StartLimitIntervalSec=180
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=@WORKING_DIRECTORY@
ExecStart=/bin/bash "@CODE_ROOT@/serve-features.sh"
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillMode=control-group
LimitNOFILE=65536
UMask=0077
StandardOutput=journal
StandardError=inherit

[Install]
WantedBy=default.target
