# Unified deployment: auto selects the recognized GPU with the least used memory.
# Use a physical nvidia-smi index or full UUID to pin a specific GPU.
ISAAC_GPU=auto
ISAACSIM_BACKEND=auto
ISAACSIM_HOST=127.0.0.1
ISAACSIM_PORT=8321
# ISAACSIM_STATE_ROOT=/absolute/path/to/state

# RTX: existing official Isaac Sim 6.x standalone runtime.
# ISAAC_SIM_DIR=/absolute/path/to/isaacsim

# A100/A800: optional reuse of the isolated CUDA/Mitsuba runtime.
# A100SIM_ROOT=/absolute/path/to/runtime
# A100SIM_CONFIG=/absolute/path/to/backend.env
# A100SIM_PYTHON=/absolute/path/to/portable/python3.12
# A100SIM_CUDA_ROOT=/usr/local/cuda
# A100SIM_NVIDIA_DEB_URL=https://.../matching-libnvidia-gl.deb
# Set after accepting NVIDIA's Isaac Sim additional software terms.
# OMNI_KIT_ACCEPT_EULA=YES
